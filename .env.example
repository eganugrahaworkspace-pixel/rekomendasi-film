# Copy this file to .env.local and fill in ONE of the two credentials below.
# Get them at https://www.themoviedb.org/settings/api
#
# These are server-only variables (no NEXT_PUBLIC_ prefix), so the key is
# never shipped to the browser.

# Recommended: "API Read Access Token" (v4, sent as a Bearer header)
TMDB_ACCESS_TOKEN=

# Alternative: "API Key" (v3, sent as a query parameter)
TMDB_API_KEY=
